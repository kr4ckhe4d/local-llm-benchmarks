@@ -237,3 +240,134 @@ void ggml_cuda_op_mul_l2_norm(ggml_backend_cuda_context & ctx, const ggml_cgraph
     mul_l2_norm_f32<<<grid, block_size, 0, ctx.stream()>>>((const float *) mul->src[0]->data, (const float *) mul->src[1]->data,
