From 9a07f8bedfc8df3c48ced806d744b57f8099c294 Mon Sep 17 00:00:00 2001
From: Nipuna H Herath <nipunaherath@hotmail.com>
Date: Sat, 21 Nov 2026 14:30:11 +0800
Subject: [PATCH 02/16] CUDA/HIP: pad mmvf grids of a multiple of 256 rows on
 RDNA4

On an R9700 (gfx1201) a mul_mat_vec_f grid of a multiple of 256 blocks in x
runs about twice as slow: a 1024 x 2304 BF16 matvec takes 17.2 us against
8.3 us for 1088 rows. Two idle blocks that return at the start of the kernel
avoid it: 1024 rows 7.9 us, 512 rows 14.5 -> 4.9 us, 2304 rows 23.9 -> 14.7 us.
The quantized mmvq and the MUL_MAT_ID launches show no such effect.

Inkling-2-Mini UD-Q8_K_XL tg128 37.3 -> 39.1 tok/s (BF16 K/V, output and
loop-controller projections), output unchanged. test-backend-ops MUL_MAT and
MUL_MAT_ID pass, apart from the f16 m=16 n=2105344 case that fails without
this change too.
---
 ggml/src/ggml-cuda/mmvf.cu | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmvf.cu b/ggml/src/ggml-cuda/mmvf.cu
index 154a621fa..7d6055bf1 100644
--- a/ggml/src/ggml-cuda/mmvf.cu
+++ b/ggml/src/ggml-cuda/mmvf.cu
@@ -19,7 +19,10 @@ static __global__ void mul_mat_vec_f(
         const int ncols2, const uint3 nchannels_y, const int stride_row, const int stride_col_y2, const int stride_col_dst,
         const uint3 channel_ratio, const int stride_channel_x, const int stride_channel_y, const int stride_channel_dst,
         const uint3 sample_ratio, const int stride_sample_x, const int stride_sample_y, const int stride_sample_dst,
-        const int ids_stride) {
+        const int ids_stride, const int nrows) {
+    if ((int) blockIdx.x >= nrows) {
+        return;
+    }
     const T       * GGML_CUDA_RESTRICT x   = x_ptr;
     const float   * GGML_CUDA_RESTRICT y   = y_ptr;
     const int32_t * GGML_CUDA_RESTRICT ids = ids_ptr;
@@ -448,7 +451,14 @@ static void mul_mat_vec_f_switch_fusion(
         const uint3 sample_ratio, const int stride_sample_x, const int stride_sample_y, const int stride_sample_dst,
         const dim3 & block_dims, const dim3 & block_nums, const int nbytes_shared, const int ids_stride, const cudaStream_t stream) {
 
-    const ggml_cuda_kernel_launch_params launch_params = {block_nums, block_dims, nbytes_shared, stream};
+    // RDNA4 runs a grid of a multiple of 256 blocks in x about twice as slow (e.g. 17 vs 8 us for a 1024 x 2304 BF16
+    // matrix on an R9700), two idle blocks avoid it; the idle blocks return at the start of the kernel
+    const int nrows = block_nums.x;
+    dim3 grid = block_nums;
+    if (nrows % 256 == 0 && GGML_CUDA_CC_IS_RDNA4(ggml_cuda_info().devices[ggml_cuda_get_device()].cc)) {
+        grid.x += 2;
+    }
+    const ggml_cuda_kernel_launch_params launch_params = {grid, block_dims, nbytes_shared, stream};
 
     const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr ||
         fusion.x_scale != nullptr || fusion.gate_scale != nullptr;
@@ -457,7 +467,7 @@ static void mul_mat_vec_f_switch_fusion(
             ggml_cuda_kernel_launch(mul_mat_vec_f<T, type_acc, ncols_dst, block_size, true, is_multi_token_id>, launch_params,
                 x, y, ids, fusion, dst, ncols, nchannels_y, stride_row, stride_col_y, stride_col_dst,
                 channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
-                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride);
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride, nrows);
             return;
        }
     }
@@ -467,7 +477,7 @@ static void mul_mat_vec_f_switch_fusion(
     ggml_cuda_kernel_launch(mul_mat_vec_f<T, type_acc, ncols_dst, block_size, false, is_multi_token_id>, launch_params,
         x, y, ids, fusion, dst, ncols, nchannels_y, stride_row, stride_col_y, stride_col_dst,
         channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
-        sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride);
+        sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, ids_stride, nrows);
 
 }
 
