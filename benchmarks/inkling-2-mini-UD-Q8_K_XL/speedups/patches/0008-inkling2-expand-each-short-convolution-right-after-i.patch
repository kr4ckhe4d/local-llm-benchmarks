From 5ec704d4c43413db8852dc4dcb7148c6a7c4f026 Mon Sep 17 00:00:00 2001
From: Nipuna H Herath <nipunaherath@hotmail.com>
Date: Sat, 21 Nov 2026 15:05:18 +0800
Subject: [PATCH 08/16] inkling2: expand each short convolution right after its
 state store

The concatenation, the store and the convolution with its residual and scale
then sit side by side in the graph, where the CUDA backend runs them as one
step for a generated token. R9700 tg128 42.3 -> 44.0 tok/s, 4023 -> 3681
kernels per token; output identical to the previous commit at batch 1 and 512.
---
 src/models/inkling2.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index 37690926b..3cdd1a564 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -269,7 +269,11 @@ ggml_tensor * llama_model_inkling2::graph::convolve(
         }
     }
 
-    return ggml_scale(ctx0, ggml_add(ctx0, cur, out), 1.0f/sqrtf((dynamic ? 2 : 1)*n_conv + 1));
+    out = ggml_scale(ctx0, ggml_add(ctx0, cur, out), 1.0f/sqrtf((dynamic ? 2 : 1)*n_conv + 1));
+    // right after the state store: the concatenation, the store and the convolution stay side by side in the
+    // graph, where a backend can run them as one step
+    ggml_build_forward_expand(gf, out);
+    return out;
 }
 
 // mix a cross-pass message into a looped layer input: (1 - forget)*cur + gain*message, both gated on cur and message
