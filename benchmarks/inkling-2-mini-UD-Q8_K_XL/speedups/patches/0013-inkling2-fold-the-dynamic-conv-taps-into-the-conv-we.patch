From 6e8436d2dd8c9b43d323b366fd4ea834d181ff63 Mon Sep 17 00:00:00 2001
From: Nipuna H Herath <nipunaherath@hotmail.com>
Date: Sat, 21 Nov 2026 15:25:23 +0800
Subject: [PATCH 13/16] inkling2: fold the dynamic conv taps into the conv
 weights for one token

For one token and sequence, lag l of the dynamic taps meets window column
n_conv - 1 - l, so the taps in reverse order (GET_ROWS with lag-reversing
indices built once per graph from ARANGE) add to the static weights and one
SSM_CONV does both, instead of a CONT, MUL and ADD per lag. The weights are
built before the window, so the CUDA conv-step fusion now covers all 192
convolutions of a token.

R9700 tg128 48.6 -> 50.0 tok/s, 2699 -> 2481 kernels per token. KLD vs the
original build at batch 1: ROCm 0.0018, Vulkan 0.0016.
---
 src/models/inkling2.cpp | 30 +++++++++++++++++++++++++++++-
 src/models/models.h     |  3 +++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index bfddfa143..9a404ce1a 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -171,6 +171,19 @@ ggml_tensor * llama_model_inkling2::graph::clip(ggml_tensor * cur, ggml_tensor *
     return rescale ? ggml_scale(ctx0, cur, threshold) : cur;
 }
 
+ggml_tensor * llama_model_inkling2::graph::lag_reverse(int64_t n_conv, int64_t n_heads) {
+    auto & idx = lag_reverse_idx[n_heads];
+    if (!idx) {
+        // per head: n_conv - 1, ..., 0, offset by head*n_conv
+        ggml_tensor * rev  = ggml_scale_bias(ctx0, ggml_arange(ctx0, 0, n_conv, 1), -1.0f, n_conv - 1);
+        rev = ggml_reshape_2d(ctx0, rev, n_conv, 1);
+        ggml_tensor * offs = ggml_reshape_2d(ctx0, ggml_arange(ctx0, 0, n_conv*n_heads, n_conv), 1, n_heads);
+        idx = ggml_add(ctx0, ggml_repeat(ctx0, rev, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_conv, n_heads)), offs);
+        idx = ggml_cast(ctx0, ggml_reshape_1d(ctx0, idx, n_conv*n_heads), GGML_TYPE_I32);
+    }
+    return idx;
+}
+
 ggml_tensor * llama_model_inkling2::graph::cont(ggml_tensor * cur) {
     return ggml_is_contiguous(cur) ? cur : ggml_cont(ctx0, cur);
 }
@@ -241,6 +254,21 @@ ggml_tensor * llama_model_inkling2::graph::convolve(
     const int64_t n_seq_tokens = ubatch.n_seq_tokens;
     const int64_t n_seqs       = ubatch.n_seqs;
 
+    // one token: lag l of the dynamic taps meets window column n_conv - 1 - l, so the taps in reverse order add to the
+    // static weights and a single convolution does both (built before the window, so that the window, the state
+    // store and the convolution stay side by side in the graph)
+    const bool fold_dynamic = dynamic && n_seq_tokens == 1 && n_seqs == 1;
+    if (fold_dynamic) {
+        const int64_t n_heads = dynamic->ne[0]/n_conv;
+
+        ggml_tensor * taps = ggml_get_rows(ctx0, ggml_reshape_2d(ctx0, dynamic, 1, n_conv*n_heads), lag_reverse(n_conv, n_heads));
+        taps = ggml_reshape_3d(ctx0, taps, n_conv, 1, n_heads);
+
+        weight = ggml_add(ctx0, ggml_reshape_3d(ctx0, weight, n_conv, n_channels/n_heads, n_heads), taps);
+        weight = ggml_reshape_2d(ctx0, weight, n_conv, n_channels);
+        ggml_build_forward_expand(gf, weight);
+    }
+
     ggml_tensor * past = ggml_view_3d(ctx0, history, n_conv - 1, n_channels, n_seqs, history->nb[1], history->nb[2], offset*history->nb[1]);
 
     ggml_tensor * x = ggml_transpose(ctx0, ggml_reshape_3d(ctx0, cur, n_channels, n_seq_tokens, n_seqs));
@@ -251,7 +279,7 @@ ggml_tensor * llama_model_inkling2::graph::convolve(
     ggml_tensor * out = ggml_ssm_conv(ctx0, x, weight);
     out = ggml_reshape_2d(ctx0, out, n_channels, n_tokens);
 
-    if (dynamic) {
+    if (dynamic && !fold_dynamic) {
         const int64_t n_heads = dynamic->ne[0]/n_conv;
 
         dynamic = ggml_reshape_3d(ctx0, dynamic, n_conv, n_heads, n_tokens);
diff --git a/src/models/models.h b/src/models/models.h
index b4c43e8c3..601c230df 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -2549,6 +2549,9 @@ struct llama_model_inkling2 : public llama_model_base {
         std::map<ggml_tensor *, ggml_tensor *> rms_norms;
         std::map<int64_t, ggml_tensor *> zero_sinks;
         std::map<ggml_tensor *, ggml_tensor *> padded_rel_bias; // per physical layer, shared by the loop passes
+        // I32 indices that reverse the lags of n_heads groups of n_conv dynamic convolution taps, once per graph
+        ggml_tensor * lag_reverse(int64_t n_conv, int64_t n_heads);
+        std::map<int64_t, ggml_tensor *> lag_reverse_idx;
     };
 
     std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params & params) const override;
