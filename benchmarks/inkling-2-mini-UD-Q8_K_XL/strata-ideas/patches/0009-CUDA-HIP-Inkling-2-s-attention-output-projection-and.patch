+                ggml_get_op_params_f32(cgraph->nodes[step_last], 0), cgraph->nodes[k + 3]->src[1], cgraph->nodes[step_last],
+                add2 ? (add2->src[0] == cgraph->nodes[step_last] ? add2->src[1] : add2->src[0]) : nullptr, add2);
+            return last - i;
+        }
+    }
