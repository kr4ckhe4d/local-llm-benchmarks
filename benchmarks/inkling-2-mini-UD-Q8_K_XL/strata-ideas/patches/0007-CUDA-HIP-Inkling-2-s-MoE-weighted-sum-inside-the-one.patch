From ed43dffae4885b581073b718ac3ea77e31a1bd18 Mon Sep 17 00:00:00 2001
From: Nipuna H Herath <nipunaherath@hotmail.com>
Date: Mon, 23 Nov 2026 12:13:03 +0800
Subject: [PATCH 07/10] CUDA/HIP: Inkling 2's MoE weighted sum inside the
 one-token FFN-out conv step

The weighted sum over the 8 experts (moe_weighted_reduction_f32, its order)
is computed by the conv-step thread of each channel, which uses it as the new
window column and the residual; with the layer residual after the step this
is one kernel for sum, conv, state store and residual.

R9700 Inkling-2-Mini UD-Q8_K_XL: 1,329 -> 1,281 kernels per generated token;
tg128 60.6 -> 61.0 tok/s. KLD against the previous commit, wiki.test.raw
-c 512, -ub 512 and -ub 1: 0. No separate test-backend-ops case yet.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 91 +++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/ssm-conv.cu  | 84 ++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/ssm-conv.cuh |  7 +++
 3 files changed, 182 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index f948552d2..5434f419b 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4632,6 +4632,72 @@ static int ggml_cuda_match_ssm_conv_step_residual(const ggml_cgraph * cgraph, in
     return k;
 }
 
+// one token: a MoE weighted reduction whose result goes only into the one-token conv step right after it (as its
+// new column and its residual), optionally with the residual ADD after the step. Returns the index of the last node
+// (the step's SCALE or that ADD), or -1. match receives the reduction.
+static int ggml_cuda_match_moe_conv_step(const ggml_cgraph * cgraph, int i, ggml_cuda_moe_weighted_reduction_match & match,
+        bool check_memory = true) {
+    if (!ggml_cuda_match_moe_weighted_reduction(cgraph, i, match)) {
+        return -1;
+    }
+    const ggml_tensor * md = match.dst;
+    if (md->ne[0] != match.experts->ne[0] || ggml_nelements(md) != md->ne[0] || cgraph->nodes[i + match.node_count - 1] != md) {
+        return -1; // one token
+    }
+    // the [1, nc] view of the sum the concatenation takes sits between them
+    int k = i + match.node_count;
+    while (k < cgraph->n_nodes && (cgraph->nodes[k]->op == GGML_OP_RESHAPE || cgraph->nodes[k]->op == GGML_OP_TRANSPOSE ||
+                                   cgraph->nodes[k]->op == GGML_OP_VIEW || cgraph->nodes[k]->op == GGML_OP_PERMUTE)) {
+        ++k;
+    }
+    if (k >= cgraph->n_nodes || cgraph->nodes[k]->op != GGML_OP_CONCAT) {
+        return -1;
+    }
+    const int last = ggml_cuda_match_ssm_conv_step(cgraph, k, false);
+    if (last < 0) {
+        return -1;
+    }
+    const ggml_tensor * concat = cgraph->nodes[k];
+    const ggml_tensor * conv   = cgraph->nodes[k + 4];
+    const ggml_tensor * add    = cgraph->nodes[k + 6];
+    const ggml_tensor * x      = concat->src[1];
+    const ggml_tensor * res    = add->src[0]->op == GGML_OP_RESHAPE && add->src[0]->src[0] == conv ? add->src[1] : add->src[0];
+    // the step reads the sum as x (a [1, nc] view of it) and as the residual
+    if (x->data != md->data || x->nb[1] != sizeof(float) || res->data != md->data || !ggml_is_contiguous(res) ||
+            ggml_nelements(res) != ggml_nelements(md) || conv->src[1]->ne[1] != md->ne[0]) {
+        return -1;
+    }
+    int end = last;
+    const int last2 = ggml_cuda_match_ssm_conv_step_residual(cgraph, k, last, false);
+    if (last2 > 0) {
+        end = last2;
+    }
+    if (check_memory) {
+        // read across the step: experts, scale, weights, history, conv weights; written: the sum, the state, the output
+        const ggml_tensor * out  = cgraph->nodes[end];
+        const ggml_tensor * cell = cgraph->nodes[k + 3]->src[1];
+        const ggml_tensor * ins[] = { match.experts, match.expert_scale, match.weights, concat->src[0], conv->src[1] };
+        for (const ggml_tensor * o : { (const ggml_tensor *) md, cell, out }) {
+            for (const ggml_tensor * in : ins) {
+                if (in && ggml_cuda_fusion_overlap(o, in)) {
+                    return -1;
+                }
+            }
+        }
+        if (ggml_cuda_fusion_overlap(md, cell) || ggml_cuda_fusion_overlap(md, out) || ggml_cuda_fusion_overlap(cell, out)) {
+            return -1;
+        }
+        if (last2 > 0) {
+            const ggml_tensor * add2 = cgraph->nodes[last2];
+            const ggml_tensor * res2 = add2->src[0] == cgraph->nodes[last] ? add2->src[1] : add2->src[0];
+            if (!ggml_cuda_fusion_elementwise_ok(out, res2) || ggml_cuda_fusion_overlap(md, res2) || ggml_cuda_fusion_overlap(cell, res2)) {
+                return -1;
+            }
+        }
+    }
+    return end;
+}
+
 // the number of consecutive MUL_MAT nodes from i, at most 4, that one mmvf launch can compute: one F32 vector, the
 // same src1, 2D contiguous src0 of one type and row length, and no node reading another's result
 static int ggml_cuda_mul_mat_vec_f_group(const ggml_cgraph * cgraph, int i) {
@@ -4700,6 +4766,23 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         }
     }
 
+    if (node->op == GGML_OP_MUL) {
+        ggml_cuda_moe_weighted_reduction_match match;
+        const int last = ggml_cuda_match_moe_conv_step(cgraph, i, match);
+        if (last > 0) {
+            int k = i + match.node_count;
+            while (cgraph->nodes[k]->op != GGML_OP_CONCAT) {
+                ++k;
+            }
+            const int last_step = k + 7;
+            ggml_tensor * add2 = last > last_step ? cgraph->nodes[last] : nullptr;
+            ggml_cuda_op_ssm_conv_step_moe(*cuda_ctx, match.experts, match.expert_scale, match.weights, match.dst,
+                cgraph->nodes[k], cgraph->nodes[k + 3], cgraph->nodes[k + 4], cgraph->nodes[last_step],
+                add2 ? (add2->src[0] == cgraph->nodes[last_step] ? add2->src[1] : add2->src[0]) : nullptr, add2);
+            return last - i;
+        }
+    }
+
     if (node->op == GGML_OP_MUL) {
         ggml_cuda_moe_weighted_reduction_match match;
         if (ggml_cuda_match_moe_weighted_reduction(cgraph, i, match)) {
@@ -6093,6 +6176,14 @@ static void ggml_backend_cuda_graph_optimize(ggml_backend_t backend, ggml_cgraph
             }
 
             ggml_cuda_moe_weighted_reduction_match match;
+            {
+                const int last = ggml_cuda_match_moe_conv_step(cgraph, i, match, false);
+                if (last > i) {
+                    add_alloc_deps(i, last);
+                    i = last;
+                    continue;
+                }
+            }
             if (ggml_cuda_match_moe_weighted_reduction(cgraph, i, match)) {
                 params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(match.experts), match.dst);
                 params->add_alloc_dep(params->user_data, const_cast<ggml_tensor *>(match.weights), match.dst);
diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 28007a320..c9417b2d2 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -312,3 +312,87 @@ void ggml_cuda_op_ssm_conv_step(ggml_backend_cuda_context & ctx, const ggml_tens
         default: GGML_ABORT("unsupported conv width %d", n_conv);
     }
 }
+
+// the MoE weighted sum (moe_weighted_reduction_f32 for one token, in its order) feeding the conv step as both its new
+// window column and its residual: m = sum_e (experts[e, c]*scale_e)*w_e, out = (sum(window*w) + m)*scale, the state
+// keeps the window's last n_conv - 1 columns, and with a residual ADD after the step, res2 + out is written instead
+template <int d_conv>
+static __global__ void ssm_conv_step_moe_f32(
+        const float * __restrict__ experts, const float * __restrict__ expert_scale, const float * __restrict__ weights,
+        const int n_used, float * __restrict__ moe_dst,
+        const float * __restrict__ past, const int64_t past_s1, const float * __restrict__ w, const int64_t w_s1,
+        const float scale, float * dst, float * __restrict__ state, const int nc, const float * res2, float * dst2) {
+    const int c = blockIdx.x*blockDim.x + threadIdx.x;
+    if (c >= nc) {
+        return;
+    }
+    const float first_scale = expert_scale != nullptr ? expert_scale[0] : 1.0f;
+    float m = (experts[c] * first_scale) * weights[0];
+    for (int e = 1; e < n_used; ++e) {
+        const float sc = expert_scale != nullptr ? expert_scale[e] : 1.0f;
+        m += (experts[(int64_t) e*nc + c] * sc) * weights[e];
+    }
+    moe_dst[c] = m;
+
+    float win[d_conv];
+#pragma unroll
+    for (int k = 0; k < d_conv - 1; ++k) {
+        win[k] = past[c*past_s1 + k];
+    }
+    win[d_conv - 1] = m;
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (int k = 0; k < d_conv; ++k) {
+        sumf += win[k] * w[c*w_s1 + k];
+    }
+    const float y = (sumf + m) * scale;
+
+#pragma unroll
+    for (int k = 0; k < d_conv - 1; ++k) {
+        state[c*(d_conv - 1) + k] = win[k + 1];
+    }
+    if (dst2) {
+        dst2[c] = res2[c] + y;
+    } else {
+        dst[c] = y;
+    }
+}
+
+void ggml_cuda_op_ssm_conv_step_moe(ggml_backend_cuda_context & ctx,
+        const ggml_tensor * experts, const ggml_tensor * expert_scale, const ggml_tensor * weights, ggml_tensor * moe_dst,
+        const ggml_tensor * concat, ggml_tensor * cpy, const ggml_tensor * conv, ggml_tensor * scale,
+        const ggml_tensor * res2, ggml_tensor * add2) {
+    const ggml_tensor * past  = concat->src[0];
+    const ggml_tensor * w     = conv->src[1];
+    const ggml_tensor * state = cpy->src[1];
+
+    const int nc     = (int) w->ne[1];
+    const int n_conv = (int) w->ne[0];
+    const int n_used = (int) experts->ne[1];
+
+    const int block = 256;
+    const dim3 grid((nc + block - 1) / block);
+    cudaStream_t stream = ctx.stream();
+
+    const float * e_d   = (const float *) experts->data;
+    const float * es_d  = expert_scale ? (const float *) expert_scale->data : nullptr;
+    const float * wt_d  = (const float *) weights->data;
+    float       * md_d  = (float *) moe_dst->data;
+    const float * p_d   = (const float *) past->data;
+    const float * w_d   = (const float *) w->data;
+    const float   s     = ggml_get_op_params_f32(scale, 0);
+    float       * dst_d = (float *) scale->data;
+    float       * st_d  = (float *) state->data;
+    const float * r2_d  = add2 ? (const float *) res2->data : nullptr;
+    float       * d2_d  = add2 ? (float *) add2->data : nullptr;
+    const int64_t past_s1 = past->nb[1] / sizeof(float);
+    const int64_t w_s1    = w->nb[1] / sizeof(float);
+
+    switch (n_conv) {
+        case 2: ssm_conv_step_moe_f32<2><<<grid, block, 0, stream>>>(e_d, es_d, wt_d, n_used, md_d, p_d, past_s1, w_d, w_s1, s, dst_d, st_d, nc, r2_d, d2_d); break;
+        case 3: ssm_conv_step_moe_f32<3><<<grid, block, 0, stream>>>(e_d, es_d, wt_d, n_used, md_d, p_d, past_s1, w_d, w_s1, s, dst_d, st_d, nc, r2_d, d2_d); break;
+        case 4: ssm_conv_step_moe_f32<4><<<grid, block, 0, stream>>>(e_d, es_d, wt_d, n_used, md_d, p_d, past_s1, w_d, w_s1, s, dst_d, st_d, nc, r2_d, d2_d); break;
+        default: GGML_ABORT("unsupported conv width %d", n_conv);
+    }
+}
