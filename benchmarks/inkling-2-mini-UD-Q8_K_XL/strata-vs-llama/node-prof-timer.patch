+// ---- LOCAL (not for upstream): per-launch timing for one-token graphs, GGML_CUDA_NODE_PROF=1 with
+// GGML_CUDA_DISABLE_GRAPHS=1. Each launch (a fused group counts once) is bracketed by two events; times are
+// summed per label (op, or first..last op of a fusion, plus the tensor name without its layer suffix) and
+// printed every 32 one-token graphs.
+#include <map>
+#include <string>
+#if defined(GGML_USE_HIP)
+#ifndef cudaEventCreate
+#define cudaEventCreate hipEventCreate
+#endif
+#ifndef cudaEventElapsedTime
+#define cudaEventElapsedTime hipEventElapsedTime
+#endif
+#endif
+struct ggml_cuda_node_prof {
+    bool on = getenv("GGML_CUDA_NODE_PROF") != nullptr;
+    std::vector<cudaEvent_t> ev;
+    std::vector<std::string> lab;
+    std::map<std::string, std::pair<double, long>> acc;
+    int n_tok = 0;
+    static std::string base(const char * n) {
+        std::string s(n);
+        size_t d = s.rfind('-');
+        if (d != std::string::npos && d + 1 < s.size() && isdigit((unsigned char) s[d + 1])) s = s.substr(0, d);
+        size_t sp = s.find(" (");
+        if (sp != std::string::npos) s = s.substr(0, sp);
+        return s;
+    }
+    void mark(cudaStream_t st, const std::string & l) {
+        if (ev.size() <= lab.size() * 2 + 1) { for (int i = 0; i < 4096; ++i) { cudaEvent_t e; CUDA_CHECK(cudaEventCreate(&e)); ev.push_back(e); } }
+        CUDA_CHECK(cudaEventRecord(ev[lab.size() * 2], st));
+        lab.push_back(l);
+    }
+    void end(cudaStream_t st) { CUDA_CHECK(cudaEventRecord(ev[lab.size() * 2 - 1], st)); }
+    void flush(bool one_token) {
+        if (lab.empty()) return;
+        CUDA_CHECK(cudaEventSynchronize(ev[lab.size() * 2 - 1]));
+        if (one_token) {
+            for (size_t i = 0; i < lab.size(); ++i) {
+                float ms = 0; CUDA_CHECK(cudaEventElapsedTime(&ms, ev[2 * i], ev[2 * i + 1]));
+                auto & a = acc[lab[i]]; a.first += ms; a.second += 1;
+            }
+            if (++n_tok % 32 == 0) {
+                std::vector<std::pair<std::string, std::pair<double, long>>> v(acc.begin(), acc.end());
+                std::sort(v.begin(), v.end(), [](auto & x, auto & y) { return x.second.first > y.second.first; });
+                double tot = 0; long cnt = 0; for (auto & x : v) { tot += x.second.first; cnt += x.second.second; }
+                fprintf(stderr, "[NODE-PROF] %d tokens: %.3f ms/token in %.1f launches/token\n", n_tok, tot / n_tok, (double) cnt / n_tok);
+                for (auto & x : v) fprintf(stderr, "[NODE-PROF] %8.3f ms %7.1f launches  %s\n", x.second.first / n_tok, (double) x.second.second / n_tok, x.first.c_str());
+                acc.clear(); n_tok = 0;
+            }
+        }
+        lab.clear();
+    }
+};
+static ggml_cuda_node_prof g_node_prof;
